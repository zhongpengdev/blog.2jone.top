---
import Layout from './Layout.astro';

interface Props {
  title: string;
  date: string;
  description?: string;
}

const { title, date, description } = Astro.props;
---

<Layout title={`${title} | zhongpeng`}>
  <article class="article-page">
    <header class="article-page__header">
      <h1 class="article-page__title">{title}</h1>
      <p class="article-page__date" style="margin-top: 20px;">{date}</p>
    </header>

    <div class="article-page__content prose">
      <slot />
    </div>
  </article>
</Layout>

<style is:global>
  .article-page {
    padding-top: 1.75rem;
    margin-bottom: 4rem;
  }

  .article-page__header {
    margin-bottom: 2.25rem;
  }

  .article-page__date {
    margin: 0 0 0.75rem;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .article-page__title {
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(2rem, 1.7rem + 1.2vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 600;
  }

  .article-page__description {
    max-width: none;
    margin: 1rem 0 0;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.8;
  }

  .article-page__content {
    max-width: none;
    width: 100%;
    color: var(--color-text);
  }

  .prose h2,
  .prose h3,
  .prose h4 {
    color: var(--color-heading);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .prose h2 {
    margin: 2.4rem 0 1rem;
    font-size: 1.65rem;
  }

  .prose h3 {
    margin: 2rem 0 0.9rem;
    font-size: 1.25rem;
  }

  .prose p,
  .prose li {
    font-size: 1rem;
    line-height: 1.9;
  }

  .prose p,
  .prose ul,
  .prose ol,
  .prose pre,
  .prose blockquote,
  .prose img {
    margin: 0 0 1.25rem;
  }

  .prose a {
    color: var(--color-heading);
    text-decoration: none;
    border-bottom: 1px solid rgba(128, 128, 128, 0.25);
  }

  .prose blockquote {
    padding-left: 1rem;
    border-left: 2px solid var(--color-skill-border);
    color: var(--color-muted);
  }

  .prose code {
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--color-skill-border);
    border-radius: 0.35rem;
    background: var(--color-skill-bg);
    font-size: 0.92em;
  }

  .prose pre {
    overflow-x: auto;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-skill-border);
    border-radius: 14px;
    background: var(--color-code-bg);
  }

  .prose pre code {
    padding: 0;
    border: 0;
    background: transparent;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 5px;
  }
</style>
