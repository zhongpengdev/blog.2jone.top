---
import AboutSection from './AboutSection.astro';
import NotesList from './NotesList.astro';
import type { ContentListItem } from '../data/content';

interface Props {
  initialView: 'home' | 'about';
  notes: ContentListItem[];
}

const { initialView, notes } = Astro.props;
---

<div
  class="home-about-shell"
  data-home-about-shell
  data-home-title="zhongpeng"
  data-about-title="About | zhongpeng"
>
  <section
    class:list={['home-about-shell__panel', { 'home-about-shell__panel--active': initialView === 'home' }]}
    data-shell-panel="home"
    hidden={initialView !== 'home'}
    aria-hidden={initialView === 'home' ? 'false' : 'true'}
  >
    <NotesList
      notes={notes}
      eyebrow="Zhongpeng"
      eyebrowCursor={true}
      eyebrowVariant="hero"
    />
  </section>

  <section
    class:list={['home-about-shell__panel', { 'home-about-shell__panel--active': initialView === 'about' }]}
    data-shell-panel="about"
    hidden={initialView !== 'about'}
    aria-hidden={initialView === 'about' ? 'false' : 'true'}
  >
    <AboutSection />
  </section>
</div>

<script is:inline>
  (() => {
    if (window.__littleBlogShellInit) return;
    window.__littleBlogShellInit = true;

    const getShell = () => document.querySelector('[data-home-about-shell]');

    if (!getShell()) return;

    const normalizePath = (value) => {
      if (!value) return '/';
      const withLeadingSlash = value.startsWith('/') ? value : `/${value}`;
      const normalized = withLeadingSlash.replace(/\/{2,}/g, '/');
      return normalized === '/' ? normalized : normalized.replace(/\/+$/, '');
    };

    const getViewFromPath = (path) => (normalizePath(path) === '/about' ? 'about' : 'home');

    const applyView = (view, options = {}) => {
      const shell = getShell();
      if (!shell) return;

      shell.querySelectorAll('[data-shell-panel]').forEach((panel) => {
        const isActive = panel.getAttribute('data-shell-panel') === view;
        panel.hidden = !isActive;
        panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        panel.classList.toggle('home-about-shell__panel--active', isActive);
      });

      if (options.updateHistory) {
        const nextPath = view === 'about' ? '/about/' : '/';
        const method = options.history === 'replace' ? 'replaceState' : 'pushState';
        window.history[method]({}, '', nextPath);
      }

      const nextTitle =
        view === 'about'
          ? shell.getAttribute('data-about-title') || 'About'
          : shell.getAttribute('data-home-title') || 'Home';

      if (document.title !== nextTitle) {
        document.title = nextTitle;
      }
    };

    document.addEventListener('site:shell-navigate', (event) => {
      const path = event.detail?.path;
      if (!path) return;
      applyView(getViewFromPath(path), { updateHistory: true });
    });

    window.addEventListener('popstate', () => {
      applyView(getViewFromPath(window.location.pathname));
    });

    applyView(getViewFromPath(window.location.pathname), { history: 'replace' });
  })();
</script>

<style>
  .home-about-shell__panel[hidden] {
    display: none !important;
  }
</style>
