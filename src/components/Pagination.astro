---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props;

const normalizePath = (value: string) => {
  if (!value) {
    return '/';
  }

  const withLeadingSlash = value.startsWith('/') ? value : `/${value}`;
  const normalized = withLeadingSlash.replace(/\/{2,}/g, '/');

  return normalized === '/' ? normalized : normalized.replace(/\/+$/, '');
};

const withTrailingSlash = (value: string) => {
  const normalized = normalizePath(value);
  return normalized === '/' ? normalized : `${normalized}/`;
};

const resolvePageHref = (page: number) => {
  const normalizedBase = normalizePath(basePath);

  if (page <= 1) {
    return withTrailingSlash(normalizedBase);
  }

  if (normalizedBase === '/') {
    return `/page/${page}/`;
  }

  return `${withTrailingSlash(normalizedBase)}page/${page}/`;
};

const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);
const previousPage = currentPage > 1 ? currentPage - 1 : null;
const nextPage = currentPage < totalPages ? currentPage + 1 : null;
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Pagination">
      <div class="pagination__group">
        {previousPage ? (
          <a href={resolvePageHref(previousPage)} class="pagination__link pagination__link--edge">
            Prev
          </a>
        ) : (
          <span class="pagination__link pagination__link--edge pagination__link--disabled">
            Prev
          </span>
        )}

        <div class="pagination__pages">
          {
            pageNumbers.map((page) => {
              const isActive = page === currentPage;

              return isActive ? (
                <span class="pagination__link pagination__link--active" aria-current="page">
                  {page}
                </span>
              ) : (
                <a href={resolvePageHref(page)} class="pagination__link">
                  {page}
                </a>
              );
            })
          }
        </div>

        {nextPage ? (
          <a href={resolvePageHref(nextPage)} class="pagination__link pagination__link--edge">
            Next
          </a>
        ) : (
          <span class="pagination__link pagination__link--edge pagination__link--disabled">
            Next
          </span>
        )}
      </div>
    </nav>
  )
}

<style>
  .pagination {
    margin-top: 3rem;
    padding-top: 1rem;
  }

  .pagination__group {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .pagination__pages {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .pagination__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.2rem;
    height: 2.2rem;
    padding: 0 0.75rem;
    border-radius: 999px;
    color: var(--color-nav);
    text-decoration: none;
    font-size: 0.92rem;
    line-height: 1;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .pagination__link:hover {
    color: var(--color-heading);
    background: var(--color-skill-bg);
  }

  .pagination__link--edge {
    padding-inline: 0.9rem;
  }

  .pagination__link--active {
    color: var(--color-heading);
    background: var(--color-skill-bg);
    border: 1px solid var(--color-skill-border);
    font-weight: 600;
  }

  .pagination__link--disabled {
    color: var(--color-border-soft);
    background: transparent;
    pointer-events: none;
  }

  @media (max-width: 639px) {
    .pagination__group {
      justify-content: center;
    }
  }
</style>
