---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section class:list={['mdx-prose', className]}>
  <slot />
</section>

<style is:global>
  .mdx-prose {
    --mdx-color-text: #4a4a4a;
    --mdx-color-heading: #000000;
    --mdx-color-border: #000000;
    --mdx-color-surface: #ffffff;
    --mdx-color-muted-bg: #f6f7f9;
    --mdx-color-muted-border: #d8dce3;
    --mdx-color-code-inline-bg: #eff3f8;
    --mdx-color-code-inline-text: #1f2937;
    --mdx-color-pre-bg: #0f172a;
    --mdx-color-pre-border: #1e293b;
    --mdx-color-pre-text: #e2e8f0;
    --mdx-color-quote-bg: #f8fafc;
    --mdx-color-quote-border: #cbd5e1;
    color: var(--mdx-color-text);
    width: 100%;
    max-width: none;
  }

  :root[data-theme='dark'] .mdx-prose {
    --mdx-color-text: #d4d4d4;
    --mdx-color-heading: #ffffff;
    --mdx-color-border: #ffffff;
    --mdx-color-surface: #000000;
    --mdx-color-muted-bg: #13151b;
    --mdx-color-muted-border: #2d3340;
    --mdx-color-code-inline-bg: #1c2230;
    --mdx-color-code-inline-text: #d6deeb;
    --mdx-color-pre-bg: #0a0d16;
    --mdx-color-pre-border: #293041;
    --mdx-color-pre-text: #d9e2f0;
    --mdx-color-quote-bg: #11151f;
    --mdx-color-quote-border: #3b465f;
  }

  .mdx-prose :where(h1, h2, h3, h4, h5, h6) {
    margin: 1.85rem 0 0.85rem;
    color: var(--mdx-color-heading);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.025em;
  }

  .mdx-prose :where(h1) {
    font-size: clamp(1.5rem, 1.35rem + 0.7vw, 2rem);
  }

  .mdx-prose :where(h2) {
    font-size: clamp(1.3rem, 1.2rem + 0.45vw, 1.65rem);
  }

  .mdx-prose :where(h3) {
    font-size: clamp(1.12rem, 1.05rem + 0.25vw, 1.28rem);
  }

  .mdx-prose :where(h4, h5, h6) {
    font-size: 1rem;
  }

  .mdx-prose :where(p, li, blockquote, figcaption, td, th) {
    color: var(--mdx-color-text);
    font-size: 1rem;
    line-height: 1.9;
  }

  .mdx-prose :where(p, ul, ol, pre, blockquote, img, table, hr) {
    margin: 0 0 1.35rem;
  }

  .mdx-prose :where(ul, ol) {
    padding-left: 1.35rem;
  }

  .mdx-prose :where(li + li) {
    margin-top: 0.45rem;
  }

  .mdx-prose :where(strong, b, th) {
    color: var(--mdx-color-heading);
    font-weight: 700;
  }

  .mdx-prose :where(em) {
    color: var(--mdx-color-text);
  }

  .mdx-prose :where(a) {
    color: var(--mdx-color-heading);
    text-decoration-line: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.16em;
    text-decoration-color: var(--mdx-color-border);
  }

  .mdx-prose :where(a:hover) {
    background: var(--mdx-color-heading);
    color: var(--mdx-color-surface);
  }

  .mdx-prose :where(blockquote) {
    margin-inline: 0;
    padding: 0.8rem 1rem;
    border-left: 4px solid var(--mdx-color-quote-border);
    border-radius: 0.5rem;
    background: var(--mdx-color-quote-bg);
  }

  .mdx-prose :where(hr) {
    border: 0;
    border-top: 1px solid var(--mdx-color-border);
  }

  .mdx-prose :where(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    border-spacing: 0;
    table-layout: auto;
  }

  .mdx-prose :where(thead th, tbody th, td) {
    padding: 0.8rem 1rem;
    text-align: left;
    vertical-align: top;
    border: 1px solid var(--mdx-color-muted-border);
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .mdx-prose :where(thead th) {
    background: var(--mdx-color-muted-bg);
    color: var(--mdx-color-heading);
  }

  .mdx-prose :where(:not(pre) > code) {
    padding: 0.14em 0.42em;
    border: 1px solid var(--mdx-color-muted-border);
    border-radius: 0.38rem;
    background: var(--mdx-color-code-inline-bg);
    color: var(--mdx-color-code-inline-text);
    font-size: 0.88em;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New',
      monospace;
  }

  .mdx-prose :where(pre) {
    overflow-x: auto;
    padding: 1rem 1.1rem;
    border: 1px solid var(--mdx-color-pre-border);
    border-radius: 0.75rem;
    background: var(--mdx-color-pre-bg);
    line-height: 1.65;
  }

  .mdx-prose :where(pre code) {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    font-size: 0.92em;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New',
      monospace;
  }

  .mdx-prose :where(pre.astro-code) {
    background: var(--mdx-color-pre-bg) !important;
    border: 1px solid var(--mdx-color-pre-border);
    border-radius: 0.75rem;
  }

  .mdx-prose :where(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
    border-radius: 5px;
  }


  .mdx-prose > hr:first-child {
    display: none;
  }

  .mdx-prose :where(:first-child) {
    margin-top: 0;
  }
</style>
