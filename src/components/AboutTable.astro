---
interface Props {
  mobileMinWidth?: string;
}

const { mobileMinWidth = '640px' } = Astro.props;
---

<section class="about-table-block">
  <div class="about-table-block__head">
    <p class="about-table-block__eyebrow">
      <slot name="eyebrow" />
    </p>
  </div>

  <div class="about-table-block__wrap" style={`--about-table-min-width: ${mobileMinWidth};`}>
    <table class="about-table-block__table">
      <slot name="colgroup" />
      <thead>
        <tr>
          <slot name="head" />
        </tr>
      </thead>
      <tbody>
        <slot />
      </tbody>
    </table>
  </div>
</section>

<style is:global>
  .about-table-block__head {
    margin-bottom: 1.1rem;
  }

  .about-table-block__eyebrow {
    margin: 0 0 0.55rem;
    color: var(--color-muted);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-table-block__wrap {
    overflow-x: auto;
    border: 1px solid var(--color-skill-border);
    border-radius: 5px;
    background:
      linear-gradient(180deg, var(--color-note-card-top), var(--color-note-card-bottom));
  }

  .about-table-block__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .about-table-block__table th,
  .about-table-block__table td {
    padding: 1rem 1rem 0.95rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-skill-border);
    overflow-wrap: break-word;
  }

  .about-table-block__table thead th {
    color: var(--color-heading);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: rgba(127, 127, 127, 0.04);
  }

  .about-table-block__table tbody th {
    color: var(--color-heading);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.45;
  }

  .about-table-block__table tbody tr:last-child th,
  .about-table-block__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .about-table-block__table td {
    font-size: 0.98rem;
  }

  .about-table-block__col-area {
    width: 32%;
  }

  .about-table-block__col-project {
    width: 22%;
  }

  .about-table-block__col-description {
    width: 40%;
  }

  .about-table-block__col-stack {
    width: 23%;
  }

  .about-table-block__col-links {
    width: 15%;
  }

  .about-table-block__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .about-table-block__links a {
    white-space: nowrap;
  }

  @media (max-width: 639px) {
    .about-table-block__table {
      min-width: var(--about-table-min-width, 640px);
      font-size: 0.92rem;
    }
  }
</style>
