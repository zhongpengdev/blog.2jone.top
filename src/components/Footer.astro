---
interface SocialLink {
  label: string;
  href: string;
}

interface Props {
  copyrightName: string;
  socialLinks: ReadonlyArray<SocialLink>;
}

const { copyrightName, socialLinks } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__column">
    <div class="site-footer__copyright">&copy; {year} {copyrightName}</div>

    <div class="site-footer__socials">
      {
        socialLinks.map((link) => (
          <a
            href={link.href}
            class="site-footer__social-link"
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>

  <div class="theme-toggle" data-theme-toggle aria-label="Theme switcher">
    <span class="theme-toggle__pill" data-theme-toggle-pill aria-hidden="true"></span>

    <button
      type="button"
      class="theme-toggle__button"
      data-theme-value="dark"
      aria-label="Toggle dark mode"
      title="Dark Mode"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M21 14.2A9 9 0 1 1 9.8 3a7 7 0 0 0 11.2 11.2Z"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.7"
        />
      </svg>
    </button>

    <button
      type="button"
      class="theme-toggle__button"
      data-theme-value="system"
      aria-label="Follow system theme"
      title="Follow System"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect
          x="3.5"
          y="5"
          width="17"
          height="11.5"
          rx="1.8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
        />
        <path
          d="M8 19h8M10.5 16.5v2.5M13.5 16.5v2.5"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="1.7"
        />
      </svg>
    </button>

    <button
      type="button"
      class="theme-toggle__button"
      data-theme-value="light"
      aria-label="Toggle light mode"
      title="Light Mode"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle
          cx="12"
          cy="12"
          r="4.2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
        />
        <path
          d="M12 2.8v2.4M12 18.8v2.4M21.2 12h-2.4M5.2 12H2.8M18.5 5.5l-1.7 1.7M7.2 16.8l-1.7 1.7M18.5 18.5l-1.7-1.7M7.2 7.2L5.5 5.5"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="1.7"
        />
      </svg>
    </button>
  </div>
</footer>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'color-mode-preference';
    const OFFSETS = {
      dark: '0px',
      system: '28px',
      light: '56px',
    };

    const readMode = () => {
      const stored = localStorage.getItem(STORAGE_KEY);
      return stored === 'dark' || stored === 'light' || stored === 'system' ? stored : 'system';
    };

    const resolveTheme = (mode) => {
      if (mode === 'system') {
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      return mode;
    };

    const applyMode = (mode) => {
      document.documentElement.dataset.theme = resolveTheme(mode);
      localStorage.setItem(STORAGE_KEY, mode);

      document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
        if (!(toggle instanceof HTMLElement)) return;
        toggle.style.setProperty('--theme-pill-offset', OFFSETS[mode] || OFFSETS.system);

        toggle.querySelectorAll('[data-theme-value]').forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          const isActive = button.dataset.themeValue === mode;
          button.classList.toggle('theme-toggle__button--active', isActive);
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      });
    };

    const syncSystemMode = () => {
      if (readMode() === 'system') {
        applyMode('system');
      }
    };

    const applyStoredMode = () => {
      applyMode(readMode());
    };

    if (!window.__littleBlogThemeToggleInit) {
      window.__littleBlogThemeToggleInit = true;

      document.addEventListener('click', (event) => {
        const button =
          event.target instanceof Element ? event.target.closest('[data-theme-value]') : null;
        if (!(button instanceof HTMLButtonElement)) return;
        const mode = button.dataset.themeValue;
        if (mode !== 'dark' && mode !== 'light' && mode !== 'system') return;
        applyMode(mode);
      });

      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      if (typeof mediaQuery.addEventListener === 'function') {
        mediaQuery.addEventListener('change', syncSystemMode);
      } else if (typeof mediaQuery.addListener === 'function') {
        mediaQuery.addListener(syncSystemMode);
      }

      document.addEventListener('astro:after-swap', applyStoredMode);
      document.addEventListener('astro:page-load', applyStoredMode);
    }

    applyStoredMode();
  })();
</script>

<style>
  .site-footer {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    margin-top: 5rem;
    border-top: 1px solid var(--color-border-soft);
  }

  .site-footer__column {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .site-footer__copyright {
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 400;
    opacity: 0.7;
  }

  .site-footer__socials {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .site-footer__social-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-muted);
    opacity: 0.75;
    text-decoration: none;
    font-size: 0.92rem;
    transition: color 0.3s ease, opacity 0.3s ease;
  }

  .site-footer__social-link:hover {
    color: var(--color-heading);
    opacity: 1;
  }

  .site-footer__social-link:focus-visible,
  .theme-toggle__button:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .theme-toggle {
    --theme-pill-offset: 28px;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: var(--color-toggle-track);
    isolation: isolate;
  }

  .theme-toggle__pill {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--color-toggle-pill);
    transform: translateX(var(--theme-pill-offset));
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .theme-toggle__button {
    position: relative;
    z-index: 1;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-toggle-icon);
    cursor: pointer;
    transition: color 0.2s linear, background-color 0.2s ease;
  }

  .theme-toggle__button:hover {
    background: var(--color-toggle-hover);
  }

  .theme-toggle__button--active {
    background: transparent;
    color: var(--color-toggle-active-icon);
  }

  .theme-toggle__button--active:hover {
    background: transparent;
  }

  .theme-toggle__button svg {
    width: 15px;
    height: 15px;
  }

  @media (max-width: 639px) {
    .site-footer {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 1.25rem;
      padding-top: 1.25rem;
    }

    .site-footer__copyright {
      font-size: 0.95rem;
    }

    .site-footer__socials {
      gap: 0.85rem;
    }

    .theme-toggle {
      justify-self: end;
      align-self: end;
    }
  }
</style>
