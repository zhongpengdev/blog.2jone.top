---
import MdxArticleLayout from '../layouts/MdxArticleLayout.astro';
import { getAllContentPages, getContentPageBySlug } from '../data/content';

export async function getStaticPaths() {
  const entries = await getAllContentPages();

  return entries.map((entry) => ({
    params: {
      slug: entry.slug.replace(/^\/+|\/+$/g, '')
    }
  }));
}

const slug = `/${Astro.params.slug ?? ''}`;
const entry = await getContentPageBySlug(slug);

if (!entry) {
  throw new Error(`Content not found for slug: ${slug}`);
}

const Content = entry.Content;
---

<MdxArticleLayout
  title={entry.title}
  date={entry.formattedDate}
  description={entry.description}
>
  <Content />
</MdxArticleLayout>

