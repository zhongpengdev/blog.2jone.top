---
import katex from 'katex';

interface Props {
  math?: string;
}

const { math } = Astro.props;

const readSlotText = async () => {
  if (!Astro.slots.has('default')) {
    return '';
  }

  const rendered = await Astro.slots.render('default');
  return rendered.replace(/<!--[\s\S]*?-->/g, '').replace(/<[^>]*>/g, '').trim();
};

const expression = math?.trim() || (await readSlotText());
const rendered = katex.renderToString(expression || '', {
  throwOnError: false,
  displayMode: false,
  output: 'html',
});
---

<span class="inline-math" set:html={rendered}></span>
