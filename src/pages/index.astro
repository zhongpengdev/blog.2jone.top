---
import HomeAboutShell from '../components/HomeAboutShell.astro';
import { getNotes } from '../data/content';
import { paginateItems } from '../data/pagination';
import Layout from '../layouts/Layout.astro';

const allNotes = getNotes();
const pagination = paginateItems(allNotes, 1);
---

<Layout title="zhongpeng">
  <HomeAboutShell
    initialView="home"
    notes={pagination.items}
    notesPagination={{
      ...pagination,
      basePath: '/'
    }}
  />
</Layout>
