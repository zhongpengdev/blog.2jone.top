---
import PhotoGallery from '../components/PhotoGallery.vue';
import { getPhotos } from '../data/photos';
import Layout from '../layouts/Layout.astro';

const photos = getPhotos();
---

<Layout title="Photos | zhongpeng">
  <section class="photos-page">
    <header class="photos-page__header">
      <h1 class="photos-page__title">Photos</h1>
      <p class="photos-page__text">
        A visual journey through my photography, capturing moments from nature, travel, and daily
        life.
      </p>
    </header>

    <PhotoGallery client:idle photos={photos} />
  </section>
</Layout>

<style>
  .photos-page {
    padding-top: 1.75rem;
    margin-bottom: 3.5rem;
  }

  .photos-page__header {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .photos-page__title {
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(2rem, 1.7rem + 1.2vw, 2.5rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    font-weight: 600;
  }

  .photos-page__text {
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.8;
    max-width: 42rem;
  }
</style>
