---
import TerminalText from './TerminalText.astro';

interface Props {
  siteTitle: string;
  basePath?: string;
  currentPath?: string;
  navigation: ReadonlyArray<{
    title: string;
    slug: string;
  }>;
}

const { siteTitle, basePath = '/', currentPath = '/', navigation } = Astro.props;

const normalizePath = (value: string) => {
  if (!value) {
    return '/';
  }

  const withLeadingSlash = value.startsWith('/') ? value : `/${value}`;
  const normalized = withLeadingSlash.replace(/\/{2,}/g, '/');

  return normalized === '/' ? normalized : normalized.replace(/\/+$/, '');
};

const withTrailingSlash = (value: string) => {
  const normalized = normalizePath(value);
  return normalized === '/' ? normalized : `${normalized}/`;
};

const resolveHref = (base: string, slug = '') => {
  const normalizedBase = normalizePath(base);
  const normalizedSlug = normalizePath(slug);

  if (normalizedBase === '/') {
    return withTrailingSlash(normalizedSlug);
  }

  if (normalizedSlug === '/') {
    return withTrailingSlash(normalizedBase);
  }

  return withTrailingSlash(`${normalizedBase}/${normalizedSlug.slice(1)}`);
};

const normalizedCurrentPath = normalizePath(currentPath);
const homeHref = resolveHref(basePath);
const aboutHref = resolveHref(basePath, '/about');
const isHomePage = normalizedCurrentPath === '/';
const isShellPage = isHomePage || normalizedCurrentPath === '/about';
---

<header class="site-header">
  <div class="site-header__inner">
    <nav
      class:list={[
        'site-header__brand-nav',
        {
          'site-header__brand-nav--home': isHomePage,
          'site-header__brand-nav--standalone': !isShellPage,
        },
      ]}
      data-site-header
    >
      <a
        href={homeHref}
        class:list={['site-header__brand-link', { 'site-header__brand-link--hidden': isHomePage }]}
        aria-label={`${siteTitle} - Back to home`}
        data-brand-link
        data-brand-role="home"
        data-brand-target={homeHref}
        data-astro-prefetch
      >
        <TerminalText>{siteTitle}</TerminalText>
      </a>
      <a
        href={aboutHref}
        class:list={[
          'site-header__brand-link',
          {
            'site-header__brand-link--hidden': !isHomePage,
            'site-header__brand-link--standalone': !isShellPage,
          },
        ]}
        aria-label="Go to about page"
        data-brand-link
        data-brand-role="about"
        data-brand-target={aboutHref}
        data-astro-prefetch
      >
        about
      </a>
    </nav>

    <nav class="site-header__nav" aria-label="Primary">
      {
        navigation.map((item) => {
          const href = resolveHref(basePath, item.slug);
          const isActive =
            normalizedCurrentPath === normalizePath(href) ||
            normalizedCurrentPath.startsWith(`${normalizePath(href)}/`);

          return (
            <a
              href={href}
              class:list={['site-header__link', { 'site-header__link--active': isActive }]}
              data-nav-link
              data-nav-label={item.title}
              data-astro-prefetch
            >
              {item.title}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    if (window.__littleBlogHeaderInit) return;
    window.__littleBlogHeaderInit = true;
    const TRANSITION_KEY = 'little-blog-pending-navigation';

    const normalizePath = (value) => {
      if (!value) return '/';
      const withLeadingSlash = value.startsWith('/') ? value : `/${value}`;
      const normalized = withLeadingSlash.replace(/\/{2,}/g, '/');
      return normalized === '/' ? normalized : normalized.replace(/\/+$/, '');
    };

    const isShellPath = (value) => {
      const path = normalizePath(value);
      return path === '/' || path === '/about';
    };

    const readPendingNavigation = () => {
      try {
        const raw = sessionStorage.getItem(TRANSITION_KEY);
        if (!raw) return null;

        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object') return null;

        return {
          from: normalizePath(parsed.from),
          to: normalizePath(parsed.to),
          at: typeof parsed.at === 'number' ? parsed.at : 0,
        };
      } catch {
        return null;
      }
    };

    const clearPendingNavigation = () => {
      try {
        sessionStorage.removeItem(TRANSITION_KEY);
      } catch {
        // Ignore storage failures.
      }
    };

    const updateHeader = (targetPath, options = {}) => {
      const path = normalizePath(targetPath ?? window.location.pathname);
      const headers = document.querySelectorAll('[data-site-header]');
      const navLinks = document.querySelectorAll('[data-nav-link]');
      const isHome = path === '/';
      const isShell = isHome || path === '/about';
      const preserveAboutLink = options.preserveAboutLink === true;
      const syncNavLinks = options.syncNavLinks !== false;

      headers.forEach((header) => {
        header.classList.toggle('site-header__brand-nav--home', isHome);
        header.classList.toggle('site-header__brand-nav--standalone', !isShell);

        header.querySelectorAll('[data-brand-link]').forEach((link) => {
          const role = link.getAttribute('data-brand-role') || 'home';
          const shouldHide = role === 'home' ? isHome : !isHome;
          link.classList.toggle('site-header__brand-link--hidden', shouldHide);
          link.classList.toggle(
            'site-header__brand-link--standalone',
            role === 'about' && !isShell && !preserveAboutLink,
          );
        });
      });

      if (!syncNavLinks) return;

      navLinks.forEach((link) => {
        const target = normalizePath(link.getAttribute('href') || '/');
        const isActive = path === target || path.startsWith(`${target}/`);
        link.classList.toggle('site-header__link--active', isActive);
      });
    };

    document.addEventListener('click', (event) => {
      const link = event.target.closest('[data-brand-link]');
      if (!(link instanceof HTMLAnchorElement)) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (link.target && link.target !== '_self') return;

      const targetPath = normalizePath(
        link.getAttribute('data-brand-target') || link.getAttribute('href') || '/',
      );
      const shell = document.querySelector('[data-home-about-shell]');

      if (shell && (targetPath === '/' || targetPath === '/about')) {
        event.preventDefault();
        updateHeader(targetPath);
        document.dispatchEvent(
          new CustomEvent('site:shell-navigate', {
            detail: {
              path: targetPath,
            },
          }),
        );
      }
    });

    const startEntryTransition = () => {
      const currentPath = normalizePath(window.location.pathname);
      const pending = readPendingNavigation();

      if (
        pending &&
        pending.to === currentPath &&
        pending.from !== currentPath &&
        Date.now() - pending.at < 4000
      ) {
        clearPendingNavigation();
        updateHeader(pending.from, {
          preserveAboutLink: true,
          syncNavLinks: true,
        });

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            updateHeader(currentPath);
          });
        });
        return;
      }

      clearPendingNavigation();
      updateHeader(currentPath);

      if (!pending || isShellPath(pending.from) || isShellPath(currentPath)) {
        return;
      }

      const headers = document.querySelectorAll('[data-site-header]');
      headers.forEach((header) => {
        header.classList.add('site-header__brand-nav--pulse');
      });

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          headers.forEach((header) => {
            header.classList.remove('site-header__brand-nav--pulse');
          });
        });
      });
    };

    window.addEventListener('popstate', () => updateHeader());
    startEntryTransition();
  })();
</script>

<style>
  .site-header {
    width: 100%;
    padding: 0;
    background: transparent;
    margin-bottom: 3rem;
  }

  .site-header__inner {
    width: min(100%, 780px);
    min-height: 36px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .site-header__brand-nav {
    display: flex;
    align-items: center;
    height: 6rem;
    transform: translateX(0);
    transition: transform 500ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .site-header__brand-nav--home {
    transform: translateX(-6rem);
  }

  .site-header__brand-nav--pulse {
    transform: translateX(-0.35rem);
  }

  .site-header__brand-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1;
    transform: translateX(0);
    transition:
      transform 500ms cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 500ms cubic-bezier(0.22, 0.61, 0.36, 1),
      color 200ms ease;
  }

  .site-header__brand-link--hidden {
    opacity: 0;
    transform: translateX(0.35rem);
  }

  .site-header__brand-link--standalone {
    display: none;
  }

  .site-header__brand-link--hidden:hover {
    color: var(--color-muted);
  }

  .site-header__brand-link:first-child {
    display: inline-block;
    width: 6rem;
    font-family:
      'SFMono-Regular', 'Cascadia Code', 'JetBrains Mono', 'Fira Code', Consolas, monospace;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-heading);
  }

  .site-header__brand-link:hover {
    color: var(--color-heading);
  }

  .site-header__nav {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  .site-header__link {
    position: relative;
    padding: 2px 0;
    color: var(--color-nav);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: color 0.25s ease, font-weight 0.1s ease;
  }

  .site-header__link::after {
    content: attr(data-nav-label);
    display: block;
    height: 0;
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
    font-weight: 600;
  }

  .site-header__link:hover {
    color: var(--color-nav-hover);
  }

  .site-header__link--active {
    color: var(--color-nav-active);
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .site-header__inner {
      padding: 0 2rem;
      gap: 0.75rem 1rem;
    }

    .site-header__brand-link {
      font-size: 1rem;
    }

    .site-header__link {
      font-size: 0.875rem;
    }
  }

  @media (min-width: 900px) {
    .site-header__inner {
      flex-wrap: nowrap;
    }

    .site-header__nav {
      width: auto;
      flex-wrap: nowrap;
      gap: 0.75rem;
    }

    .site-header__link {
      font-size: 0.9375rem;
    }
  }
</style>
