---
import { Image } from 'astro:assets';

interface PhotoAsset {
  src: string;
  width?: number;
  height?: number;
  format?: string;
}

interface PhotoItem {
  src: string;
  image: PhotoAsset;
  alt: string;
  filename: string;
  width?: number;
  height?: number;
}

interface Props {
  photos: ReadonlyArray<PhotoItem>;
}

const { photos } = Astro.props;
---

<section class="photo-gallery" data-photo-gallery>
  {
    photos.map((photo, index) => (
      <button
        type="button"
        class="photo-gallery__item"
        aria-label={`View photo ${index + 1}`}
        data-photo-trigger
        data-photo-index={String(index)}
        data-photo-src={photo.src}
        data-photo-alt={photo.alt}
        data-photo-width={photo.width ? String(photo.width) : ''}
        data-photo-height={photo.height ? String(photo.height) : ''}
      >
        <Image
          src={photo.image}
          alt={photo.alt}
          class="photo-gallery__thumb"
          widths={[240, 480, 720]}
          sizes="(max-width: 520px) calc(100vw - 3rem), (max-width: 900px) calc((100vw - 4.75rem) / 2), 240px"
          quality={72}
          format="webp"
          loading={index < 4 ? 'eager' : 'lazy'}
          decoding={index < 4 ? 'sync' : 'async'}
          fetchpriority={index < 2 ? 'high' : 'auto'}
        />
      </button>
    ))
  }

  <div class="photo-lightbox" data-photo-lightbox hidden>
    <button type="button" class="photo-lightbox__close" data-photo-close aria-label="Close photo">
      x
    </button>
    <button
      type="button"
      class="photo-lightbox__nav photo-lightbox__nav--prev"
      data-photo-prev
      aria-label="Previous photo"
    >
      &lt;
    </button>
    <figure class="photo-lightbox__figure">
      <img class="photo-lightbox__image" data-photo-image alt="" decoding="async" />
    </figure>
    <button
      type="button"
      class="photo-lightbox__nav photo-lightbox__nav--next"
      data-photo-next
      aria-label="Next photo"
    >
      &gt;
    </button>
  </div>
</section>

<script is:inline>
  (() => {
    const galleries = document.querySelectorAll('[data-photo-gallery]');

    galleries.forEach((gallery) => {
      if (!(gallery instanceof HTMLElement) || gallery.dataset.photoGalleryBound === 'true') {
        return;
      }

      gallery.dataset.photoGalleryBound = 'true';

      const triggers = Array.from(gallery.querySelectorAll('[data-photo-trigger]')).filter(
        (node) => node instanceof HTMLButtonElement,
      );
      const lightbox = gallery.querySelector('[data-photo-lightbox]');
      const lightboxImage = gallery.querySelector('[data-photo-image]');
      const closeButton = gallery.querySelector('[data-photo-close]');
      const prevButton = gallery.querySelector('[data-photo-prev]');
      const nextButton = gallery.querySelector('[data-photo-next]');

      if (
        !(lightbox instanceof HTMLElement) ||
        !(lightboxImage instanceof HTMLImageElement) ||
        !(closeButton instanceof HTMLButtonElement) ||
        !(prevButton instanceof HTMLButtonElement) ||
        !(nextButton instanceof HTMLButtonElement)
      ) {
        return;
      }

      let activeIndex = -1;

      const onKeydown = (event) => {
        if (event.key === 'Escape') {
          close();
        } else if (event.key === 'ArrowLeft') {
          step(-1);
        } else if (event.key === 'ArrowRight') {
          step(1);
        }
      };

      const applyPhoto = (index) => {
        const nextTrigger = triggers[index];
        if (!(nextTrigger instanceof HTMLButtonElement)) return;

        const nextSrc = nextTrigger.dataset.photoSrc || '';
        const nextAlt = nextTrigger.dataset.photoAlt || '';
        const nextWidth = nextTrigger.dataset.photoWidth;
        const nextHeight = nextTrigger.dataset.photoHeight;

        lightboxImage.src = nextSrc;
        lightboxImage.alt = nextAlt;

        if (nextWidth) {
          lightboxImage.width = Number(nextWidth);
        } else {
          lightboxImage.removeAttribute('width');
        }

        if (nextHeight) {
          lightboxImage.height = Number(nextHeight);
        } else {
          lightboxImage.removeAttribute('height');
        }
      };

      const open = (index) => {
        activeIndex = index;
        applyPhoto(activeIndex);
        lightbox.hidden = false;
        document.body.style.overflow = 'hidden';
        window.addEventListener('keydown', onKeydown);
      };

      const close = () => {
        activeIndex = -1;
        lightbox.hidden = true;
        lightboxImage.removeAttribute('src');
        lightboxImage.alt = '';
        document.body.style.overflow = '';
        window.removeEventListener('keydown', onKeydown);
      };

      const step = (direction) => {
        if (activeIndex < 0 || triggers.length === 0) return;
        activeIndex = (activeIndex + direction + triggers.length) % triggers.length;
        applyPhoto(activeIndex);
      };

      gallery.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const trigger = target.closest('[data-photo-trigger]');
        if (trigger instanceof HTMLButtonElement) {
          const index = Number(trigger.dataset.photoIndex || '-1');
          if (index >= 0) {
            open(index);
          }
          return;
        }

        if (target === lightbox) {
          close();
        }
      });

      closeButton.addEventListener('click', close);
      prevButton.addEventListener('click', () => step(-1));
      nextButton.addEventListener('click', () => step(1));
    });
  })();
</script>

<style>
  .photo-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 2.2rem;
  }

  .photo-gallery__item {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 0;
    padding: 0;
    background: var(--color-skill-bg);
    cursor: zoom-in;
    overflow: hidden;
    content-visibility: auto;
    contain-intrinsic-size: 280px;
  }

  .photo-gallery__thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateZ(0);
    transition: transform 0.28s ease;
  }

  .photo-gallery__item:hover .photo-gallery__thumb {
    transform: scale(1.02);
  }

  .photo-lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 10, 12, 0.92);
    padding: 2rem;
  }

  .photo-lightbox__figure {
    margin: 0;
    max-width: min(1200px, calc(100vw - 7rem));
    max-height: calc(100vh - 4rem);
  }

  .photo-lightbox__image {
    display: block;
    max-width: 100%;
    max-height: calc(100vh - 4rem);
    object-fit: contain;
  }

  .photo-lightbox__close,
  .photo-lightbox__nav {
    border: 0;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    cursor: pointer;
  }

  .photo-lightbox__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    font-size: 1rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .photo-lightbox__nav {
    width: 44px;
    height: 72px;
    border-radius: 999px;
    font-size: 1.4rem;
    line-height: 1;
  }

  .photo-lightbox__nav--prev {
    margin-right: 1rem;
  }

  .photo-lightbox__nav--next {
    margin-left: 1rem;
  }

  @media (max-width: 900px) {
    .photo-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .photo-gallery {
      grid-template-columns: 1fr;
    }

    .photo-lightbox {
      padding: 1rem;
    }

    .photo-lightbox__figure {
      max-width: calc(100vw - 4rem);
    }

    .photo-lightbox__nav {
      width: 38px;
      height: 60px;
    }
  }
</style>
